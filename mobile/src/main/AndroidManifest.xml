<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sicherung (Einstellungen, Lizenz/Testphase; ohne Caches): data_extraction_rules ab Android 12,
         backup_rules bis Android 11. Sprachen: locales_config (Englisch, Deutsch). Zurück-Geste: Predictive Back
         (ab targetSdk 36 ohnehin Standard; Compose und Navigation behandeln sie, kein onBackPressed im Code). -->
    <application
        android:name=".DeskBreakPhoneApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeskBreakPhone">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- singleTop: Ein Deep Link bei laufender App landet in onNewIntent statt in einer zweiten Activity. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Deep Link deskbreak://unlock (DeepLinks.UNLOCK in :shared): „Am Handy freischalten" auf der Uhr öffnet
                darüber per RemoteActivityHelper die Seite „DeskBreak freischalten". Öffnet nur diese Seite, ohne
                Parameter und ohne etwas auszulösen – darf deshalb jede App bzw. jeder Browser aufrufen.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="deskbreak"
                    android:host="unlock" />
            </intent-filter>
        </activity>

        <!--
            Empfängt Snapshots und Antworten der Uhr auch im Hintergrund. Muss exportiert sein, damit die
            Play Services ihn binden können; zugestellt wird nur, was von einer gekoppelten Uhr mit derselben
            App-ID und Signatur kommt.
        -->
        <service
            android:name=".sync.DeskBreakListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/deskbreak/snapshot" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/deskbreak/restore-result" />
            </intent-filter>
        </service>
    </application>
</manifest>
