<?xml version="1.0" encoding="utf-8"?>
<!--
    Sprachen der Handy-App für die Spracheinstellung pro App (Android 13+, android:localeConfig). Muss zu den
    ausgelieferten Übersetzungen passen: values/ (Englisch) und values-de/ (Deutsch), siehe localeFilters in
    mobile/build.gradle.kts.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
</locale-config>
